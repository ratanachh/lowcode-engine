{
  "name": "@rchh/lowcode-react-renderer",
  "version": "1.3.5",
  "description": "react renderer for ali lowcode engine",
  "main": "lib/index.js",
  "module": "es/index.js",
  "files": [
    "lib",
    "es",
    "dist"
  ],
  "scripts": {
    "test": "build-scripts test --config build.test.json",
    "start": "build-scripts start",
    "build": "build-scripts build",
    "build:umd": "NODE_OPTIONS='--max_old_space_size=8192 --openssl-legacy-provider --no-strip-types' build-scripts build --config build.umd.json"
  },
  "keywords": [
    "lowcode",
    "engine",
    "react"
  ],
  "dependencies": {
    "@alifd/next": "^1.21.16",
    "@rchh/lowcode-renderer-core": "1.3.4"
  },
  "devDependencies": {
    "@alib/build-scripts": "^0.1.18",
    "@alifd/next": "^1.19.17",
    "build-plugin-fusion": "^0.1.0",
    "build-plugin-moment-locales": "^0.1.0",
    "react": "^16.4.1",
    "react-dom": "^16.4.1",
    "react-test-renderer": "^16"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "http",
    "url": "https://github.com/ratanachh/lowcode-engine/tree/main/packages/react-renderer"
  },
  "homepage": "https://ratanachh.github.io/lowcode-engine/",
  "gitHead": "22fef37bb07fe7c05679db4d56cbabb0efa485a1",
  "bugs": "https://github.com/ratanachh/lowcode-engine/issues"
}
